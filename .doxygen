PROJECT_NAME           = "ejs"
PROJECT_BRIEF          = "embedded JavaScript"
PROJECT_LOGO           = doc/logo.png
HTML_OUTPUT            = doc/html
OUTPUT_DIRECTORY       =
INPUT                  = README.md inc src doc hw os
INCLUDE_PATH           = inc
EXCLUDE                = ref/* *.pdf *.djvu hw/f4disco/Core hw/f4disco/Drivers
WARN_IF_UNDOCUMENTED   = NO
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_LATEX         = NO
FILE_PATTERNS         += *.lex *.yacc
EXTENSION_MAPPING      = lex=C++ yacc=C++ ino=C++
EXTRACT_ALL            = YES
EXTRACT_STATI          = YES
EXTRACT_PRIVATE        = YES
LAYOUT_FILE            = doc/DoxygenLayout.xml
SORT_GROUP_NAMES       = YES
REPEAT_BRIEF           = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
# DISABLE_INDEX          = YES 
GENERATE_TREEVIEW      = NO
