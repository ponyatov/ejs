{
    "version": 6,
    "configurePresets": [
        {
            "name": "common",
            "hidden": true,
            "binaryDir": "${sourceDir}/tmp/${presetName}",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/${presetName}",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_VERBOSE_MAKEFILE": true,
                "CMAKE_C_STANDARD": "17",
                "CMAKE_CXX_STANDARD": "17"
            }
        },
        {
            "name": "cortexM",
            "hidden": true,
            "inherits": "common",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
            "cacheVariables": {
                "WFLAGS":     "-Wall -Wextra -Wpedantic",
                "FSECTIONS":  "-fdata-sections -ffunction-sections",
                "OS":         "bare"
            }
        },
        {
            "name": "cortexM4",
            "hidden": true,
            "inherits": "cortexM",
            "cacheVariables": {
                "MCPU": "-mcpu=cortex-m4",
                "MFPU": "-mfpu=fpv4-sp-d16 -mfloat-abi=hard"
            }
        },
        {
            "name": "f4disco",
            "inherits": "cortexM4",
            "description": "Cortex-M4 STM32F407VGT @ stm32f4discovery",
            "cacheVariables": {
                 "HW": "f4disco",
                "CPU": "STM32F407VGT",
                "HAL": "STM32F4"}
        },
        {
            "name": "linux",
            "displayName": "x86_64-linux-gnu",
            "description": "native host",
            "toolchainFile": "${sourceDir}/cmake/x86_64-linux-gnu.cmake",
            "inherits": "common",
            "cacheVariables": {"HW":"x86_64","OS":"linux"}
        }
    ]
}
